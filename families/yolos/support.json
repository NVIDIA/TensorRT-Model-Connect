{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "yolos"
          ]
        }
      },
      "then": {
        "tasks": [
          "object_detection"
        ],
        "default_task": "object_detection"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "YolosForObjectDetection"
          ]
        }
      },
      "then": {
        "tasks": [
          "object_detection"
        ],
        "default_task": "object_detection"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "YolosForObjectDetection"
          ]
        }
      },
      "then": {
        "tasks": [
          "object_detection"
        ],
        "default_task": "object_detection"
      }
    }
  ]
}
