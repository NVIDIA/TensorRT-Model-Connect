{
  "version": 1,
  "commands": [
    {
      "name": "build", "help": "Build the Clef structured-decision model", "executor": "python", "handler": "cli:build",
      "arguments": [
        {"name": "model", "type": "string"},
        {"name": "output", "flags": ["-o", "--output"], "type": "path", "required": true},
        {"name": "revision", "flags": ["--revision"], "type": "string"},
        {"name": "max_sequence_length", "flags": ["--max-sequence-length"], "type": "int", "default": 16384},
        {"name": "max_questions", "flags": ["--max-questions"], "type": "int", "default": 64},
        {"name": "max_options", "flags": ["--max-options"], "type": "int", "default": 512},
        {"name": "verbose", "flags": ["--verbose"], "type": "bool", "action": "store_true", "default": false}
      ]
    },
    {
      "name": "decide", "help": "Answer a JSON record using Clef", "executor": "native", "handler": "decide",
      "arguments": [
        {"name": "bundle", "type": "path"},
        {"name": "record", "flags": ["--record"], "type": "path", "required": true},
        {"name": "runtime_root", "flags": ["--runtime-root"], "type": "path"},
        {"name": "max_state_tokens", "flags": ["--max-state-tokens"], "type": "int", "default": -1}
      ]
    }
  ]
}
