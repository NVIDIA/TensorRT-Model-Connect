{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "smollm3"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "SmolLM3ForCausalLM"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "SmolLM3ForCausalLM"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    }
  ]
}
