{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "timm_efficientnet",
            "efficientnet_b0",
            "efficientnet_b1",
            "efficientnet_b2",
            "efficientnet_b3",
            "efficientnet_b4",
            "efficientnet_b5",
            "efficientnet_b6",
            "efficientnet_b7"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "efficientnet_b0",
            "efficientnet_b1",
            "efficientnet_b2",
            "efficientnet_b3",
            "efficientnet_b4",
            "efficientnet_b5",
            "efficientnet_b6",
            "efficientnet_b7"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "efficientnet_b0",
            "efficientnet_b1",
            "efficientnet_b2",
            "efficientnet_b3",
            "efficientnet_b4",
            "efficientnet_b5",
            "efficientnet_b6",
            "efficientnet_b7"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    }
  ]
}
