{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "decoder_ce",
            "magpie_tts",
            "magpietts"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_generation"
        ],
        "default_task": "audio_generation"
      }
    },
    {
      "if": {
        "files_all": [
          "magpie_tts_multilingual_357m.nemo"
        ]
      },
      "then": {
        "tasks": [
          "audio_generation"
        ],
        "default_task": "audio_generation"
      }
    }
  ]
}
