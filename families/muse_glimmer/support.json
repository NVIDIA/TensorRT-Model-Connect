{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "muse_glimmer",
            "muse_glimmer_text"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation",
        "default_precision": "fp16"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "MuseGlimmerForConditionalGeneration"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation",
        "default_precision": "fp16"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "MuseGlimmerForConditionalGeneration"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation",
        "default_precision": "fp16"
      }
    }
  ]
}
