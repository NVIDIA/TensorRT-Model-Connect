{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "audio-spectrogram-transformer"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_to_class_scores"
        ],
        "default_task": "audio_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "ASTForAudioClassification"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_to_class_scores"
        ],
        "default_task": "audio_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "ASTForAudioClassification"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_to_class_scores"
        ],
        "default_task": "audio_to_class_scores"
      }
    }
  ]
}
