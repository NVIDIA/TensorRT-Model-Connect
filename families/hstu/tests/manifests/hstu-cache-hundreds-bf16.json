{
  "name": "hstu-cache-hundreds-bf16",
  "family": "hstu",
  "task": "recommendation",
  "bundle": "hstu-cache-hundreds-bf16.bundle",
  "precision": "bf16",
  "max_batch_size": 2,
  "tensor_parallel_size": 1,
  "testcases": [
    {
      "name": "hstu-cache-hundreds-bf16",
      "premerge": true,
      "cache_scenario": "hundreds",
      "config_overrides": {
        "enable_history_cache": true,
        "hidden_size": 128,
        "num_heads": 4,
        "head_dim": 32,
        "num_layers": 2,
        "max_sequence_length": 1024,
        "position_buckets": 1024,
        "scaling_seqlen": 1024,
        "disable_contextual_mask": true
      },
      "fixture": {
        "history_lengths": [
          200,
          137
        ],
        "candidate_lengths": [
          256,
          256
        ],
        "context_counts": [
          2,
          1
        ]
      }
    }
  ]
}
