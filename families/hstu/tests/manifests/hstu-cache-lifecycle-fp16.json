{
  "name": "hstu-cache-lifecycle-fp16",
  "family": "hstu",
  "task": "recommendation",
  "bundle": "hstu-cache-lifecycle-fp16.bundle",
  "precision": "fp16",
  "max_batch_size": 2,
  "tensor_parallel_size": 1,
  "testcases": [
    {
      "name": "hstu-cache-lifecycle-fp16",
      "premerge": true,
      "cache_scenario": "lifecycle",
      "config_overrides": {
        "enable_history_cache": true,
        "hidden_size": 16,
        "num_heads": 2,
        "head_dim": 8,
        "num_layers": 2,
        "max_sequence_length": 32,
        "position_buckets": 32,
        "scaling_seqlen": 32,
        "disable_contextual_mask": true
      }
    }
  ]
}
