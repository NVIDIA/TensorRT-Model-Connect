{
  "name": "hstu-session-retrieval-fp32",
  "family": "hstu",
  "task": "recommendation",
  "bundle": "hstu-session-retrieval-fp32.bundle",
  "precision": "fp32",
  "max_batch_size": 1,
  "tensor_parallel_size": 1,
  "testcases": [
    {
      "name": "hstu-session-retrieval-fp32",
      "premerge": true,
      "session_scenario": "retrieval",
      "decode_steps": 20,
      "config_overrides": {
        "enable_history_cache": true,
        "disable_contextual_mask": true,
        "hidden_size": 16,
        "num_heads": 2,
        "head_dim": 8,
        "num_layers": 2,
        "max_sequence_length": 128,
        "position_buckets": 128,
        "scaling_seqlen": 128,
        "mode": "retrieval",
        "embedding_tables": [
          {
            "name": "item",
            "role": "item",
            "num_embeddings": 24
          },
          {
            "name": "action",
            "role": "action",
            "num_embeddings": 5
          },
          {
            "name": "context",
            "role": "context",
            "num_embeddings": 6
          }
        ]
      }
    }
  ]
}
