{
  "name": "hstu-session-tiny-bf16",
  "family": "hstu",
  "task": "recommendation",
  "bundle": "hstu-session-tiny-bf16.bundle",
  "precision": "bf16",
  "max_batch_size": 1,
  "tensor_parallel_size": 1,
  "testcases": [
    {
      "name": "hstu-session-tiny-bf16",
      "premerge": true,
      "session_scenario": "tiny",
      "decode_steps": 20,
      "config_overrides": {
        "enable_history_cache": true,
        "disable_contextual_mask": true,
        "hidden_size": 16,
        "num_heads": 2,
        "head_dim": 8,
        "num_layers": 2,
        "max_sequence_length": 128,
        "position_buckets": 128,
        "scaling_seqlen": 128
      }
    }
  ]
}
