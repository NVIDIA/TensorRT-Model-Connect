{
  "name": "hstu-tiny-retrieval-features-fp32",
  "family": "hstu",
  "task": "recommendation",
  "bundle": "hstu-tiny-retrieval-features-fp32.bundle",
  "precision": "fp32",
  "max_batch_size": 2,
  "tensor_parallel_size": 1,
  "testcases": [
    {
      "name": "hstu-tiny-retrieval-features-fp32",
      "premerge": true,
      "config_overrides": {
        "mode": "retrieval",
        "embedding_tables": [
          {
            "name": "item",
            "role": "item",
            "num_embeddings": 24
          },
          {
            "name": "action",
            "role": "action",
            "num_embeddings": 5
          },
          {
            "name": "context",
            "role": "context",
            "num_embeddings": 6
          }
        ]
      }
    }
  ]
}
