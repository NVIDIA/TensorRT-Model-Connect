ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The runtime loads libtesseract.so.5 (Tesseract OCR, Apache-2.0) with its English data,
# and the reference pipeline runs the tesseract command of the same packages; the E2E
# was validated with Ubuntu 24.04's 5.3.4 and English data 4.1.0.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && tesseract --version

COPY requirements.txt /opt/trtmc-ci/family-requirements.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
        --no-build-isolation -r /opt/trtmc-ci/family-requirements.txt \
    && python -m pip check
