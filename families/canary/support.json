{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "canary",
            "canary_asr",
            "enc_dec_multi_task"
          ]
        }
      },
      "then": {
        "tasks": [
          "transcription"
        ],
        "default_task": "transcription"
      }
    }
  ]
}
