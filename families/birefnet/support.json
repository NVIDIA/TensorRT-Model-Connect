{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "BiRefNet"
          ]
        }
      },
      "then": {
        "tasks": [
          "segmentation"
        ],
        "default_task": "segmentation"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "BiRefNet"
          ]
        }
      },
      "then": {
        "tasks": [
          "segmentation"
        ],
        "default_task": "segmentation"
      }
    }
  ]
}
