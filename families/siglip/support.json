{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "siglip"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_embedding",
          "text_to_embedding",
          "text_image_to_relevance"
        ],
        "default_task": "text_image_to_relevance"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "SiglipModel"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_embedding",
          "text_to_embedding",
          "text_image_to_relevance"
        ],
        "default_task": "text_image_to_relevance"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "SiglipModel"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_embedding",
          "text_to_embedding",
          "text_image_to_relevance"
        ],
        "default_task": "text_image_to_relevance"
      }
    }
  ]
}
