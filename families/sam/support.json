{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "sam"
          ]
        }
      },
      "then": {
        "tasks": [
          "prompted_segmentation"
        ],
        "default_task": "prompted_segmentation"
      }
    }
  ]
}
