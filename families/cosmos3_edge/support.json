{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "cosmos3_edge"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation",
          "vision_language_generation",
          "text_continuation",
          "images_text_to_text",
          "video_text_to_text",
          "image_video_text_to_text"
        ],
        "default_task": "vision_language_generation"
      }
    }
  ]
}
