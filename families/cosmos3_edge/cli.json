{
  "version": 1,
  "commands": [
    {
      "name": "build",
      "help": "Build one Cosmos3-Edge reasoning bundle",
      "executor": "python",
      "handler": "edge_llm.cli:build",
      "arguments": [
        {
          "name": "model",
          "type": "string",
          "help": "Hugging Face model ID or local snapshot"
        },
        {
          "name": "output",
          "flags": [
            "-o",
            "--output"
          ],
          "type": "path",
          "required": true
        },
        {
          "name": "revision",
          "flags": [
            "--revision"
          ],
          "type": "string"
        },
        {
          "name": "task",
          "flags": [
            "--task"
          ],
          "type": "string",
          "choices": [
            "text_generation",
            "vision_language_generation",
            "text_continuation",
            "images_text_to_text",
            "video_text_to_text",
            "image_video_text_to_text"
          ],
          "default": "vision_language_generation"
        },
        {
          "name": "precision",
          "flags": [
            "--precision"
          ],
          "type": "string",
          "choices": [
            "fp32",
            "fp16",
            "bf16"
          ],
          "help": "TensorRT compute precision",
          "default": "fp32"
        },
        {
          "name": "backend",
          "flags": [
            "--backend"
          ],
          "type": "string",
          "choices": [
            "trt"
          ],
          "default": "trt"
        },
        {
          "name": "max_sequence_length",
          "flags": [
            "--max-sequence-length"
          ],
          "type": "int"
        },
        {
          "name": "tensor_parallel_size",
          "flags": [
            "--tensor-parallel-size"
          ],
          "type": "int",
          "choices": [
            1
          ],
          "default": 1
        },
        {
          "name": "verbose",
          "flags": [
            "--verbose"
          ],
          "type": "bool",
          "action": "store_true",
          "default": false
        },
        {
          "name": "quantization",
          "flags": [
            "--quantization"
          ],
          "type": "string",
          "choices": [
            "none"
          ],
          "help": "Original unquantized reasoning checkpoint"
        },
        {
          "name": "edge_builder_python",
          "flags": [
            "--edge-builder-python"
          ],
          "type": "path",
          "help": "Absolute Python interpreter for the optional Edge builder"
        }
      ]
    }
  ]
}
