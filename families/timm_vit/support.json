{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "timm_vit",
            "timmvit",
            "vision_transformer",
            "vit_base_patch16_224"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "vit_base_patch16_224"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "vit_base_patch16_224"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_to_class_scores"
        ],
        "default_task": "image_to_class_scores"
      }
    }
  ]
}
