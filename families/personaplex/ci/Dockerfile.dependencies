ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Runtime-only dependency for Native-compatible HQ audio resampling.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsoxr0 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /opt/trtmc-ci/family-requirements.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
        -r /opt/trtmc-ci/family-requirements.txt && \
    python -m pip check
