{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "fnet"
          ]
        }
      },
      "then": {
        "tasks": [
          "embedding",
          "encoding",
          "reranking"
        ],
        "default_task": "encoding"
      }
    }
  ]
}
