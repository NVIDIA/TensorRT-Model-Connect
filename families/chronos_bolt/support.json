{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "chronos_bolt",
            "chronos-bolt",
            "chronosbolt"
          ]
        }
      },
      "then": {
        "tasks": [
          "time_series_forecast"
        ],
        "default_task": "time_series_forecast"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "ChronosBoltModelForForecasting"
          ]
        }
      },
      "then": {
        "tasks": [
          "time_series_forecast"
        ],
        "default_task": "time_series_forecast"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "ChronosBoltModelForForecasting"
          ]
        }
      },
      "then": {
        "tasks": [
          "time_series_forecast"
        ],
        "default_task": "time_series_forecast"
      }
    }
  ]
}
