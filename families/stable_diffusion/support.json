{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/model_index/_class_name": {
          "in": [
            "StableDiffusionPipeline"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_generation"
        ],
        "default_task": "image_generation"
      }
    }
  ]
}
