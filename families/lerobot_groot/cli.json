{
  "version": 1,
  "commands": [
    {
      "name": "build",
      "help": "Build a GR00T N1.7 LIBERO action policy",
      "executor": "python",
      "handler": "edge_llm.cli:build",
      "arguments": [
        {
          "name": "model",
          "type": "string",
          "help": "Hugging Face model ID or local snapshot"
        },
        {
          "name": "output",
          "flags": [
            "-o",
            "--output"
          ],
          "type": "path",
          "required": true
        },
        {
          "name": "revision",
          "flags": [
            "--revision"
          ],
          "type": "string"
        },
        {
          "name": "precision",
          "flags": [
            "--precision"
          ],
          "type": "string",
          "choices": [
            "fp16"
          ],
          "help": "TensorRT compute precision",
          "default": "fp16"
        },
        {
          "name": "verbose",
          "flags": [
            "--verbose"
          ],
          "type": "bool",
          "action": "store_true",
          "default": false
        },
        {
          "name": "edge_builder_python",
          "flags": [
            "--edge-builder-python"
          ],
          "type": "path",
          "help": "Absolute Python interpreter for the optional Edge builder"
        }
      ]
    }
  ]
}
