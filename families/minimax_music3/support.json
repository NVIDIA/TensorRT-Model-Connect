{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "minimax_music3",
            "minimaxmusic3"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_generation"
        ],
        "default_task": "audio_generation"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "MiniMaxMusic3ForConditionalGeneration"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_generation"
        ],
        "default_task": "audio_generation"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "MiniMaxMusic3ForConditionalGeneration"
          ]
        }
      },
      "then": {
        "tasks": [
          "audio_generation"
        ],
        "default_task": "audio_generation"
      }
    }
  ]
}
