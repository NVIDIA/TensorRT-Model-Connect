{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "m2m100",
            "m2m_100",
            "nllb"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    }
  ]
}
