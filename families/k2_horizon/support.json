{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "k2_horizon"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "K2HorizonForCausalLM"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "K2HorizonForCausalLM"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    }
  ]
}
