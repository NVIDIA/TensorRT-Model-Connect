{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "falcon",
            "refinedweb",
            "refinedwebmodel"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_generation"
        ],
        "default_task": "text_generation"
      }
    }
  ]
}
