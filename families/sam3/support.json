{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "sam3",
            "sam3-video",
            "sam3_video"
          ]
        }
      },
      "then": {
        "tasks": [
          "text_prompted_segmentation"
        ],
        "default_task": "text_prompted_segmentation"
      }
    }
  ]
}
