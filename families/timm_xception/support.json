{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "timm_xception",
            "xception41"
          ]
        }
      },
      "then": {
        "tasks": [
          "classification"
        ],
        "default_task": "classification"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "xception41"
          ]
        }
      },
      "then": {
        "tasks": [
          "classification"
        ],
        "default_task": "classification"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "xception41"
          ]
        }
      },
      "then": {
        "tasks": [
          "classification"
        ],
        "default_task": "classification"
      }
    }
  ]
}
