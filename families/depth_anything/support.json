{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "depth_anything"
          ]
        }
      },
      "then": {
        "tasks": [
          "monocular_depth"
        ],
        "default_task": "monocular_depth"
      }
    },
    {
      "if": {
        "/config/architectures": {
          "contains_any": [
            "DepthAnythingForDepthEstimation"
          ]
        }
      },
      "then": {
        "tasks": [
          "monocular_depth"
        ],
        "default_task": "monocular_depth"
      }
    },
    {
      "if": {
        "/config/architecture": {
          "in": [
            "DepthAnythingForDepthEstimation"
          ]
        }
      },
      "then": {
        "tasks": [
          "monocular_depth"
        ],
        "default_task": "monocular_depth"
      }
    }
  ]
}
