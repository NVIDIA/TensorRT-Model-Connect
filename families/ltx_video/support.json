{
  "schema_version": 1,
  "rules": [
    {
      "if": {
        "/config/model_type": {
          "in": [
            "ltx",
            "ltx-video",
            "ltx_video",
            "ltxpipeline",
            "ltxvideo"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_generation"
        ],
        "default_task": "image_generation"
      }
    },
    {
      "if": {
        "/model_index/_class_name": {
          "in": [
            "LTXPipeline"
          ]
        }
      },
      "then": {
        "tasks": [
          "image_generation"
        ],
        "default_task": "image_generation"
      }
    }
  ]
}
