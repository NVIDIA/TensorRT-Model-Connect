{
  "title": "Serve one text-generation request",
  "description": "The pipeline tokenizes the prompt, initializes model-owned state, performs one prefill, and checks EOS or answer-stop after each sampled token before another engine step; the max-token budget is enforced at the loop boundary after that step.",
  "subtitle": "EOS or answer-stop skips the next engine step; the token budget is the decode loop boundary.",
  "participants": [
    {"id": "app", "label": "App", "color": "api"},
    {"id": "pipeline", "label": "Pipeline", "color": "runtime"},
    {"id": "tokenizer", "label": "Tokenizer", "color": "neutral"},
    {"id": "state", "label": "KV state", "color": "artifact"},
    {"id": "module", "label": "TRT module", "color": "build"},
    {"id": "sampler", "label": "Sampler", "color": "validation"}
  ],
  "messages": [
    {"kind": "section", "label": "1 · Prepare request state"},
    {"number": 1, "from": "app", "to": "pipeline", "label": "generate(...)"},
    {"number": 2, "from": "pipeline", "to": "tokenizer", "label": "Encode prompt"},
    {"number": 3, "from": "tokenizer", "to": "pipeline", "label": "Prompt token IDs", "style": "return"},
    {"number": 4, "from": "pipeline", "to": "state", "label": "Reset and bind request"},
    {"kind": "section", "label": "2 · Prefill once"},
    {"number": 5, "from": "pipeline", "to": "module", "label": "Prefill prompt tokens"},
    {"number": 6, "from": "module", "to": "state", "label": "Return KV tensors", "style": "return"},
    {"number": 7, "from": "module", "to": "pipeline", "label": "Initial logits", "style": "return"},
    {"kind": "section", "label": "3 · Repeat: sample and check stop before another engine step"},
    {"number": 8, "from": "pipeline", "to": "sampler", "label": "Choose from logits"},
    {"number": 9, "from": "sampler", "to": "pipeline", "label": "Next token ID", "style": "return"},
    {"number": 10, "from": "pipeline", "to": "pipeline", "label": "Append + check stop"},
    {"kind": "section", "label": "Unless EOS or answer-stop fires"},
    {"number": 11, "from": "pipeline", "to": "state", "label": "Prepare position and mask"},
    {"number": 12, "from": "pipeline", "to": "module", "label": "Forward chosen token"},
    {"number": 13, "from": "module", "to": "pipeline", "label": "Next logits", "style": "return"},
    {"number": 14, "from": "module", "to": "state", "label": "Updated KV tensors", "style": "return"},
    {"number": 15, "from": "state", "to": "state", "label": "Advance position"},
    {"number": 16, "from": "pipeline", "to": "pipeline", "label": "Loop boundary checks budget"},
    {"kind": "section", "label": "4 · Return typed output"},
    {"number": 17, "from": "pipeline", "to": "tokenizer", "label": "Decode output IDs"},
    {"number": 18, "from": "tokenizer", "to": "pipeline", "label": "Output text", "style": "return"},
    {"number": 19, "from": "pipeline", "to": "app", "label": "TextResult", "style": "return"}
  ]
}
