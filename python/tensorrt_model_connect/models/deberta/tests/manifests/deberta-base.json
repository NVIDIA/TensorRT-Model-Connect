{
  "name": "deberta-base",
  "hf_id": "microsoft/deberta-base",
  "bundle": "deberta-base.bundle",
  "family": "deberta",
  "runtime_strategy": "deberta_encoder_only",
  "task_strategy": "encoder_only_nlp",
  "precision": "fp16",
  "max_cache_length": 256,
  "trust_remote_code": false,
  "testcases": [
    {
      "name": "deberta-base",
      "reference_family": "encoder_base_features",
      "user_contract": "representation_parity",
      "reference_precision": "fp32",
      "task_eval": {
        "comparison_precision": "fp32"
      },
      "prompt": "The capital of France is Paris.",
      "max_new_tokens": 1,
      "notes": "Encoder-only model with disentangled attention. Outputs hidden states, not logits.",
      "core": false,
      "metadata": {
        "contract_config": {
          "auto_class": "AutoModel"
        }
      }
    }
  ]
}
