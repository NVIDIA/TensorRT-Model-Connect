{
  "name": "patchtst-etth1-regression-distribution-tp4",
  "hf_id": "ibm-research/patchtst-etth1-regression-distribution",
  "bundle": "patchtst-etth1-regression-distribution-tp4.bundle",
  "family": "patchtst",
  "runtime_strategy": "patchtst_trt",
  "task_strategy": "neural_operator",
  "precision": "fp32",
  "max_cache_length": 512,
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 4
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "testcases": [
    {
      "name": "patchtst-etth1-regression-distribution-tp4",
      "reference_backend": "torch_reference",
      "reference_family": "time_series_regression",
      "user_contract": "time_series_regression",
      "oracle_level": "L1_external_reference",
      "ci_tier": "multi_device",
      "preflight_requirements": [
        {
          "kind": "binary_exists",
          "args": {},
          "gating": true
        },
        {
          "kind": "command_available",
          "args": {
            "command": "mpirun"
          },
          "gating": true
        },
        {
          "kind": "gpu_count_min",
          "args": {
            "count": 4
          },
          "gating": true
        }
      ],
      "inputs": {
        "field_input": [
          0.1,
          -0.2,
          0.05,
          0.3,
          -0.15,
          0.25,
          0.4,
          0.2,
          -0.1,
          0.1,
          0.35,
          -0.05,
          0.2,
          0.5,
          0.3,
          0.0,
          0.15,
          0.4,
          0.05,
          0.15,
          0.6,
          0.4,
          0.1,
          0.2,
          0.45,
          0.1,
          0.1,
          0.7,
          0.55,
          0.05
        ]
      },
      "metadata": {
        "core": false,
        "notes": "PatchTST regression TP4 repro using the same checkpoint, precision, inputs, and thresholds as patchtst-etth1-regression-distribution."
      }
    }
  ]
}
