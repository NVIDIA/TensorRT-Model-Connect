+def test_real_triton64_from_mask_custom_op_matches_explicit_reference():
+    """Tiny non-uniform/prefix-exempt map covers the real opaque CUDA route."""
+    if vsa_h3.map_to_index is None or vsa_h3.block_sparse_attn_triton is None:
+        pytest.skip("requires the Triton tile-64 VSA dependencies")
+
+    torch.manual_seed(17)
+    device = torch.device("cuda")
+    q = torch.randn(1, _HEADS, 128, _DIM, device=device, dtype=torch.bfloat16)
+    k = torch.randn_like(q)
+    v = torch.randn_like(q)
+    # Tile zero models a prefix and remains exempt/dense. Tile one uses a
+    # head-dependent sparse selection so compaction counts are non-uniform.
+    block_map = torch.tensor(
+        [[[[True, True], [True, False]], [[True, True], [False, True]]]],
+        device=device,
+        dtype=torch.bool,
