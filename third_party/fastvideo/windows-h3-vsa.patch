+def test_grad_enabled_gate_merge_preserves_saved_attention_output(monkeypatch):
+    """A CuTe-style saved output must retain its version through backward."""
+    meta = _build_meta(sparsity=0.5, prefix_segments=(64, 64), tile_size=256)
+    impl = MiniMaxH3VSAImpl(num_heads=_HEADS, head_size=_DIM, causal=False, softmax_scale=_DIM**-0.5)
+    q, k, v = _tiled_qkv(meta, requires_grad=True)
+    gate = torch.randn_like(q) * 0.125
+    kernel_output = {}
+
+    class _SavedOutput(torch.autograd.Function):
+
+        @staticmethod
+        def forward(ctx, q, k, v):
+            out = q + k + v
+            ctx.save_for_backward(out)
+            return out
+
+        @staticmethod
+        def backward(ctx, grad_output):
+            # Accessing saved_tensors performs the version check that the real
+            # CuTe/FA4 backward relies on before consuming its saved output.
+            (saved_output, ) = ctx.saved_tensors
+            assert saved_output.shape == grad_output.shape
+            return grad_output, grad_output, grad_output
+
+    def fake_cute(q, k, v, block_map, variable_block_sizes):
+        del block_map, variable_block_sizes
