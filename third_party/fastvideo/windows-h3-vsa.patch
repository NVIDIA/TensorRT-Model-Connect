+def _mock_process_group_init(monkeypatch):
+    calls = []
+    monkeypatch.setattr(parallel_state.torch.distributed, "is_initialized", lambda: False)
+    monkeypatch.setattr(
+        parallel_state.torch.distributed,
+        "init_process_group",
