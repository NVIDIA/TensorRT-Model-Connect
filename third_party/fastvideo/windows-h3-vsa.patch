+    monkeypatch.setattr(parallel_state, "init_world_group", lambda ranks, local_rank, backend: object())
+    monkeypatch.setattr(parallel_state, "init_node_group", lambda local_rank, backend: None)
+    monkeypatch.setattr(parallel_state, "_WORLD", None)
+    monkeypatch.setattr(parallel_state, "_NODE", object())
+    return calls
+
+
+def test_cuda_without_nccl_uses_gloo_for_one_process(monkeypatch, cuda_platform_without_nccl) -> None:
+    calls = _mock_process_group_init(monkeypatch)
+
+    parallel_state.init_distributed_environment(
+        world_size=1,
+        rank=0,
+        local_rank=0,
+        distributed_init_method="file:///unused",
+    )
+
+    assert calls == [{
+        "backend": "gloo",
+        "init_method": "file:///unused",
+        "world_size": 1,
+        "rank": 0,
+    }]
+
+
+def test_cuda_without_nccl_rejects_multiple_processes(monkeypatch, cuda_platform_without_nccl) -> None:
+    init_process_group = pytest.fail
+    monkeypatch.setattr(parallel_state.torch.distributed, "init_process_group", init_process_group)
+
+    with pytest.raises(RuntimeError, match="Gloo fallback is intentionally limited to world_size=1"):
+        parallel_state.init_distributed_environment(world_size=2, rank=0, local_rank=0)
+
+
+def test_windows_cuda_uses_single_process_fallback_even_if_nccl_is_reported(monkeypatch) -> None:
+    monkeypatch.setattr(current_platform, "is_cuda_alike", lambda: True)
+    monkeypatch.setattr(current_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(parallel_state.torch.distributed, "is_nccl_available", lambda: True)
+    monkeypatch.setattr(parallel_state, "os", SimpleNamespace(name="nt"))
+    calls = _mock_process_group_init(monkeypatch)
+
+    parallel_state.init_distributed_environment(
+        world_size=1,
+        rank=0,
+        local_rank=0,
+        distributed_init_method="file:///unused",
+    )
+
+    assert calls[0]["backend"] == "gloo"
+
+
+def test_cuda_with_nccl_keeps_nccl(monkeypatch) -> None:
+    monkeypatch.setattr(current_platform, "is_cuda_alike", lambda: True)
+    monkeypatch.setattr(current_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(parallel_state.torch.distributed, "is_nccl_available", lambda: True)
+    monkeypatch.setattr(parallel_state, "os", SimpleNamespace(name="posix"))
+    calls = _mock_process_group_init(monkeypatch)
+
+    parallel_state.init_distributed_environment(
+        world_size=1,
+        rank=0,
+        local_rank=0,
+        distributed_init_method="file:///unused",
+    )
+
+    assert calls[0]["backend"] == "nccl"
