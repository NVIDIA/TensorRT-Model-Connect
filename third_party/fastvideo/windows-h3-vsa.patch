+    variable_block_sizes = torch.tensor([64, 37], device=device, dtype=torch.int32)
+
+    with torch.inference_mode():
+        actual, _ = vsa_h3._triton64_from_mask(q, k, v, block_map, variable_block_sizes)
+
+        token_map = block_map.repeat_interleave(64, dim=-2).repeat_interleave(64, dim=-1)
+        key_valid = torch.cat((torch.ones(64, device=device, dtype=torch.bool),
+                               torch.arange(64, device=device) < 37))
+        allowed = token_map & key_valid.view(1, 1, 1, -1)
+        scores = torch.matmul(q.float(), k.float().transpose(-2, -1)) / (_DIM**0.5)
