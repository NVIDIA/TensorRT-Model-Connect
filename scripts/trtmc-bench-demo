#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0

set -uo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly BENCH="${SCRIPT_DIR}/trtmc-bench"

readonly -a ALL_TASKS=(
  generate
  generate-image
  generate-image-batch
  edit-image
  generate-video
  encode
  embed
  solve
  transcribe
)

if [[ -d /runs/engines/bundles ]]; then
  bundle_cache=/runs/engines/bundles
else
  bundle_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/trtmc/bench/bundles"
fi

if [[ -d /runs/results ]]; then
  results_parent=/runs/results
else
  results_parent="${REPO_ROOT}/trtmc-bench-results"
fi

results_dir="${results_parent}/demo-$(date -u +%Y%m%d-%H%M%SZ)"
allow_build=0
dry_run=0
list_only=0
declare -a requested_tasks=()
declare -a bundle_args=()

usage() {
  cat <<'EOF'
Run editable performance examples for the major TRTMC task types.

Usage:
  ./scripts/trtmc-bench-demo [OPTIONS] [TASK ...]

Options:
  --bundle-cache PATH  Bundle cache/root to reuse (default: /runs/engines/bundles
                       when available)
  --results PATH       Parent directory for all model results and the merged report
  --allow-build        Build a missing bundle; default behavior is reuse-only
  --dry-run            Resolve and print cases without executing inference
  --list               List task names and exit
  -h, --help           Show this help

Tasks:
  generate              Text generation with DistilGPT2
  generate-image        Text-to-image with FLUX.1 Schnell
  generate-image-batch  Batch-two text-to-image with FLUX.1 Schnell
  edit-image            Image editing with Qwen-Image-Edit
  generate-video        Text-to-video with LTX-Video
  encode                Encoder-only NLP with BERT
  embed                 Text embedding with Nemotron Embed VL
  solve                 Time-series forecast with Chronos Bolt
  transcribe            Speech-to-text with Whisper

If TASK is omitted, all tasks run. Each task writes one model result below PATH;
after execution, trtmc-bench combines them into PATH/report.html.
EOF
}

list_tasks() {
  printf '%s\n' "${ALL_TASKS[@]}"
}

die() {
  echo "trtmc-bench-demo: error: $*" >&2
  exit 2
}

while (($#)); do
  case "$1" in
    --bundle-cache)
      (($# >= 2)) || die "--bundle-cache requires a path"
      bundle_cache=$2
      shift 2
      ;;
    --results)
      (($# >= 2)) || die "--results requires a path"
      results_dir=$2
      shift 2
      ;;
    --allow-build)
      allow_build=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --list)
      list_only=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      requested_tasks+=("$@")
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      requested_tasks+=("$1")
      shift
      ;;
  esac
done

if ((list_only)); then
  list_tasks
  exit 0
fi

[[ -x "${BENCH}" ]] || die "benchmark CLI is not executable: ${BENCH}"

if ((${#requested_tasks[@]} == 0)); then
  requested_tasks=("${ALL_TASKS[@]}")
fi

is_known_task() {
  local candidate=$1
  local known
  for known in "${ALL_TASKS[@]}"; do
    if [[ "${candidate}" == "${known}" ]]; then
      return 0
    fi
  done
  return 1
}

declare -A selected_tasks=()
declare -a tasks=()
for task in "${requested_tasks[@]}"; do
  is_known_task "${task}" || die "unknown task: ${task}; use --list"
  if [[ -z "${selected_tasks[${task}]:-}" ]]; then
    selected_tasks["${task}"]=1
    tasks+=("${task}")
  fi
done

if ((allow_build == 0)) && [[ ! -d "${bundle_cache}" ]]; then
  die "bundle cache does not exist: ${bundle_cache}; set --bundle-cache or use --allow-build"
fi

resolve_bundle_args() {
  local model=$1
  local bundle_name=$2
  local model_cache="${bundle_cache}/${model}"
  local managed_json managed_path
  local -a matches=()

  bundle_args=(--bundle-cache "${bundle_cache}")
  if [[ -d "${model_cache}" ]]; then
    mapfile -d '' matches < <(find "${model_cache}" -type f -name "${bundle_name}" -print0)
  fi

  if ((${#matches[@]} == 1)); then
    bundle_args+=(--bundle "${matches[0]}" --no-build)
    return 0
  fi

  if ((${#matches[@]} > 1)); then
    if managed_json=$("${BENCH}" run \
      --model "${model}" \
      --bundle-cache "${bundle_cache}" \
      --no-build \
      --dry-run 2>/dev/null); then
      managed_path=$(python3 -c \
        'import json, sys; print(json.load(sys.stdin)[0]["bundle_path"])' \
        <<<"${managed_json}")
      if [[ -f "${managed_path}" ]]; then
        bundle_args+=(--bundle "${managed_path}" --no-build)
        return 0
      fi
    fi
    if ((allow_build)); then
      return 0
    fi
    echo "trtmc-bench-demo: multiple bundles match ${model}/${bundle_name}," >&2
    echo "and none is the current managed-cache entry; rerun with --allow-build" >&2
    return 1
  fi

  if ((allow_build)); then
    return 0
  fi
  echo "trtmc-bench-demo: no bundle found for ${model} below ${model_cache};" >&2
  echo "set --bundle-cache to a prepared cache or rerun with --allow-build" >&2
  return 1
}

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

failures=0
runs_started=0

run_case() {
  local task=$1
  local model=$2
  local bundle_name=$3
  local warmup=$4
  local iterations=$5
  shift 5

  echo
  echo "==> ${task}: ${model}"
  if ! resolve_bundle_args "${model}" "${bundle_name}"; then
    ((failures += 1))
    return
  fi

  local -a command=(
    "${BENCH}" run
    --model "${model}"
    "${bundle_args[@]}"
    --warmup "${warmup}"
    --iterations "${iterations}"
    "$@"
  )
  if ((dry_run)); then
    command+=(--dry-run)
  else
    command+=(-o "${results_dir}/${model}")
  fi

  print_command "${command[@]}"
  ((runs_started += 1))
  if ! "${command[@]}"; then
    ((failures += 1))
  fi
}

for task in "${tasks[@]}"; do
  case "${task}" in
    generate)
      run_case "${task}" distilgpt2 distilgpt2.trtfb 3 20 \
        --set 'request.prompt=Benchmark this custom text workload.' \
        --set request.max_new_tokens=32 \
        --set request.temperature=0.0 \
        --set request.seed=-1
      ;;
    generate-image)
      run_case "${task}" flux-schnell-l0 flux-schnell-l0.trtfb 1 5 \
        --set 'request.prompt=A neon-blue sports car driving through a rainy city at night' \
        --set request.seed=123 \
        --set request.num_inference_steps=8
      ;;
    generate-image-batch)
      run_case "${task}" flux-schnell-l0-batch2 flux-schnell-l0-batch2.trtfb 1 5 \
        --set request.batch_size=2 \
        --set 'request.prompts=["A red cube on a white table","A blue sphere on a black table"]' \
        --set 'request.seeds=[11,22]' \
        --set request.num_inference_steps=8
      ;;
    edit-image)
      run_case "${task}" qwen-image-edit-2511 qwen-image-edit-2511.trtfb 1 3 \
        --set 'request.prompt=Turn the scene into a watercolor painting' \
        --set "request.image_path=${REPO_ROOT}/tests/e2e/models/qwen_image/data/test_img.jpeg" \
        --set request.num_inference_steps=10
      ;;
    generate-video)
      run_case "${task}" ltx-video-l0 ltx-video-l0.trtfb 1 3 \
        --set 'request.prompt=A paper airplane glides above a quiet mountain lake' \
        --set request.seed=7 \
        --set request.num_inference_steps=10
      ;;
    encode)
      run_case "${task}" bert-base-uncased bert-base-uncased.trtfb 10 100 \
        --set 'request.prompt=TensorRT accelerates neural network inference.'
      ;;
    embed)
      run_case "${task}" nemotron-embed-vl-1b-v2 nemotron-embed-vl-1b-v2.trtfb 10 100 \
        --set 'request.prompt=How does GPU inference reduce latency?'
      ;;
    solve)
      run_case "${task}" chronos-bolt-tiny-official chronos-bolt-tiny-official.trtfb 10 100 \
        --set 'request.branch_input=[101.0,101.2,101.1,101.4,101.6,101.5,101.8,102.0,102.2,102.1,102.4,102.6]'
      ;;
    transcribe)
      run_case "${task}" whisper-tiny-fp16 whisper-tiny-fp16.trtfb 1 10 \
        --set "request.audio_path=${REPO_ROOT}/tests/e2e/models/whisper/data/Recording.wav" \
        --set request.max_new_tokens=32 \
        --set request.language=en
      ;;
  esac
done

if ((dry_run)); then
  echo
  echo "Dry run complete: ${runs_started} task(s) resolved, ${failures} failed."
elif ((runs_started > 0)); then
  echo
  echo "==> Building merged report"
  report_command=("${BENCH}" report "${results_dir}")
  print_command "${report_command[@]}"
  if ! "${report_command[@]}"; then
    ((failures += 1))
  fi
  echo "Results: ${results_dir}"
  echo "Report:  ${results_dir}/report.html"
fi

if ((failures > 0)); then
  echo "trtmc-bench-demo: ${failures} task/report step(s) failed" >&2
  exit 1
fi
