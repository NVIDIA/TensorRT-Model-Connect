  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "debug_logits": true,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
