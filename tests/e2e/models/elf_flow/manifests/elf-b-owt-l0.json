{
  "name": "elf-b-owt-l0",
  "hf_id": "embedded-language-flows/ELF-B-owt",
  "bundle": "elf-b-owt-l0.trtfb",
  "family": "elf_flow",
  "runtime_strategy": "elf_flow",
  "task_strategy": "diffusion_text_generation",
  "precision": "fp32",
  "max_cache_length": 1024,
  "testcases": [
    {
      "name": "elf-b-owt-l0",
      "trace_id": "IT-E2E-ELFB-OWT-L0-01",
      "reference_backend": "upstream_replay",
      "oracle_level": "L1_external_reference",
      "reference_family": "elf_unconditional_text",
      "user_contract": "diffusion_text_generation",
      "ci_tier": "contract_only",
      "max_new_tokens": 1024,
      "inputs": {
        "generation_mode": "unconditional",
        "dataset_contract": "OpenWebText-style unconditional samples",
        "num_samples": 1,
        "sampling_method": "ode",
        "num_sampling_steps": 32,
        "self_cond_cfg_scale": 3.0,
        "cfg_scale": 1.0,
        "elf_replay_artifact": "data/elf-b-owt-replay/artifact.json",
        "output_schema": "jsonl lines with id, generated, and token_ids"
      },
      "stages": [
        {
          "name": "flow_sampling",
          "required": true,
          "artifact_type": "embedding",
          "comparison_mode": "invariant_check"
        },
        {
          "name": "final_decode",
          "required": true,
          "artifact_type": "logits",
          "comparison_mode": "numeric_tensor"
        },
        {
          "name": "decoded_text",
          "required": true,
          "artifact_type": "text_samples",
          "comparison_mode": "text_quality_metrics"
        }
      ],
      "metadata": {
        "github_reference": "https://github.com/lillian039/ELF",
        "upstream_entrypoint": "src/eval.py --config configs/training_configs/train_owt_ELF-B.yml",
        "expected_report": "Gen. PPL around 24 and unigram entropy around 5.15 for ELF-B at 32 SDE steps.",
        "notes": "Replays one deterministic ODE32 sample exported by the official ELF JAX evaluator. The FP32 TensorRT result must retain at least 99% positional token agreement and at most 0.01 normalized text edit distance against the JAX replay; this bounds observed cross-framework tactic variation across TensorRT releases. ODE avoids committing the much larger stochastic-noise trace required by SDE while retaining the upstream implementation and checkpoint."
      }
    }
  ]
}
