{
  "name": "bart-base-tp4",
  "hf_id": "facebook/bart-base",
  "bundle": "bart-base-tp4.trtfb",
  "family": "bart",
  "runtime_strategy": "seq2seq_encoder_decoder",
  "max_cache_length": 256,
  "prompt": "The quick brown fox jumps over the lazy dog.",
  "max_new_tokens": 20,
  "logit_atol": 1e-3,
  "threshold_overrides": {
    "logit_cosine_p5": 0.0,
    "logit_rel_l2_p95": 999.0,
    "token_agreement_rate": 0.0,
    "stable_top1_match_rate": 0.0,
    "unstable_topk_hit_rate": 0.0
  },
  "ci_tier": "multi_device",
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 4
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "preflight_requirements": [
    {
      "kind": "binary_exists",
      "args": {},
      "gating": true
    },
    {
      "kind": "command_available",
      "args": {
        "command": "mpirun"
      },
      "gating": true
    },
    {
      "kind": "gpu_count_min",
      "args": {
        "count": 4
      },
      "gating": true
    }
  ],
  "notes": "BART-base TP4 repro using the same checkpoint, prompt, generation length, and thresholds as bart-base."
}
