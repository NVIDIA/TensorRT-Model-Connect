{
  "name": "yi-1.5-6b-chat-tp2",
  "trace_id": "IT-E2E-YI15-6B-TP2-01",
  "hf_id": "01-ai/Yi-1.5-6B-Chat",
  "bundle": "yi-1.5-6b-chat-tp2.trtfb",
  "family": "llama",
  "runtime_strategy": "decoder_kv_cache",
  "precision": "fp16",
  "max_cache_length": 256,
  "prompt": "What is the capital of Switzerland? Answer in one word.",
  "max_new_tokens": 10,
  "trust_remote_code": false,
  "ci_tier": "multi_device",
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": { "mode": "tensor_parallel", "tp_size": 2 }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 2,
    "debug_logits": true,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "preflight_requirements": [
    { "kind": "binary_exists", "args": {}, "gating": true },
    { "kind": "command_available", "args": { "command": "mpirun" }, "gating": true },
    { "kind": "gpu_count_min", "args": { "count": 2 }, "gating": true }
  ],
  "threshold_overrides": {
    "logit_cosine_p5": 0.95,
    "logit_rel_l2_p95": 0.15
  }
}
