{
  "name": "phi-moe-l0-tp4",
  "hf_id": "microsoft/Phi-tiny-MoE-instruct",
  "bundle": "phi-moe-l0-tp4.trtfb",
  "family": "phi_moe",
  "runtime_strategy": "phi_moe_decoder_kv_cache",
  "task_strategy": "text_generation_causal",
  "e2e_parallel_resource": "exclusive_gpu",
  "max_cache_length": 256,
  "trust_remote_code": false,
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 4
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "debug_logits": true,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "testcases": [
    {
      "name": "phi-moe-l0-tp4",
      "trace_id": "IT-E2E-PHIMOE-L0-TP4-01",
      "ci_tier": "multi_device",
      "reference_family": "chat_instruct_template",
      "user_contract": "chat_response",
      "prompt": "Name the largest ocean on Earth.",
      "max_new_tokens": 5,
      "preflight_requirements": [
        {
          "kind": "binary_exists",
          "args": {},
          "gating": true
        },
        {
          "kind": "command_available",
          "args": {
            "command": "mpirun"
          },
          "gating": true
        },
        {
          "kind": "gpu_count_min",
          "args": {
            "count": 4
          },
          "gating": true
        }
      ],
      "notes": "Phi-MoE TP4 repro using the same checkpoint, prompt, generation length, and thresholds as phi-moe-l0.",
      "metadata": {
        "contract_config": {
          "use_chat_template": true,
          "enable_thinking": false
        }
      }
    }
  ]
}
