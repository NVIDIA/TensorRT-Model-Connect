{
  "name": "alpamayo-r1-10b-tp2",
  "trace_id": "IT-E2E-ALPAMAYO-R1-10B-TP2-01",
  "hf_id": "nvidia/Alpamayo-R1-10B",
  "bundle": "alpamayo-r1-10b-tp2.trtfb",
  "family": "alpamayo_r1",
  "runtime_strategy": "vision_language",
  "precision": "bf16",
  "max_cache_length": 384,
  "prompt": "What color is the vehicle in this image? Answer in one word.",
  "max_new_tokens": 10,
  "test_image": "tests/e2e/data/test_img.jpeg",
  "trust_remote_code": true,
  "ci_tier": "multi_device",
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 2
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 2,
    "debug_logits": true,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "preflight_requirements": [
    { "kind": "binary_exists", "args": {}, "gating": true },
    { "kind": "command_available", "args": { "command": "mpirun" }, "gating": true },
    { "kind": "gpu_count_min", "args": { "count": 2 }, "gating": true }
  ],
  "notes": "Alpamayo-R1-10B VLM TP=2 lane. Same alpamayo_r1 family plugin as the single-device lane, but TP=2 sharding across 2 GPUs. Required for hosts with <33 GB single-device free memory (TRT engine workspace for the 8.2B Qwen3-VL backbone is ~33 GB regardless of bf16 storage)."
}
