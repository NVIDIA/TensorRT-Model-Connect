{
  "name": "whisper-tiny-fp16-tp2",
  "hf_id": "openai/whisper-tiny",
  "bundle": "whisper-tiny-fp16-tp2.trtfb",
  "family": "whisper",
  "runtime_strategy": "whisper_speech_to_text",
  "task_strategy": "speech_to_text",
  "precision": "fp16",
  "fp32_layers": [0],
  "max_cache_length": 64,
  "trust_remote_code": false,
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 2
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 2,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "testcases": [
    {
      "name": "whisper-tiny-fp16-tp2",
      "trace_id": "IT-E2E-WHSPT-FP16-TP2-01",
      "reference_family": "asr_whisper",
      "user_contract": "exact_transcript",
      "test_type": "transcription",
      "reference_precision": "fp32",
      "prompt": "test",
      "max_new_tokens": 10,
      "test_input_audio": "data/Recording.wav",
      "ci_tier": "multi_device",
      "preflight_requirements": [
        {
          "kind": "binary_exists",
          "args": {},
          "gating": true
        },
        {
          "kind": "command_available",
          "args": {
            "command": "mpirun"
          },
          "gating": true
        },
        {
          "kind": "gpu_count_min",
          "args": {
            "count": 2
          },
          "gating": true
        }
      ]
    }
  ]
}
