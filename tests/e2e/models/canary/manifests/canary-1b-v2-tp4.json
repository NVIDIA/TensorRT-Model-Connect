{
  "name": "canary-1b-v2-tp4",
  "hf_id": "nvidia/canary-1b-v2",
  "bundle": "canary-1b-v2-tp4.trtfb",
  "family": "canary",
  "runtime_strategy": "canary_speech_to_text",
  "task_strategy": "speech_to_text",
  "max_cache_length": 128,
  "trust_remote_code": false,
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 4
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "testcases": [
    {
      "name": "canary-1b-v2-tp4",
      "trace_id": "IT-E2E-CANRY-TP4-01",
      "reference_family": "asr_canary",
      "user_contract": "exact_transcript",
      "test_type": "transcription",
      "prompt": "test",
      "max_new_tokens": 50,
      "test_input_audio": "data/Recording.wav",
      "ci_tier": "multi_device",
      "preflight_requirements": [
        {
          "kind": "binary_exists",
          "args": {},
          "gating": true
        },
        {
          "kind": "command_available",
          "args": {
            "command": "mpirun"
          },
          "gating": true
        },
        {
          "kind": "gpu_count_min",
          "args": {
            "count": 4
          },
          "gating": true
        }
      ]
    }
  ]
}
