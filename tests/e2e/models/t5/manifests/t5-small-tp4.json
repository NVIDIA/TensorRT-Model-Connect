{
  "name": "t5-small-tp4",
  "hf_id": "google-t5/t5-small",
  "bundle": "t5-small-tp4.bundle",
  "family": "t5",
  "runtime_strategy": "t5_text_to_text",
  "task_strategy": "text_generation_causal",
  "max_cache_length": 256,
  "e2e_parallel_resource": "exclusive_gpu",
  "build_args": {
    "parallel": {
      "mode": "tensor_parallel",
      "tp_size": 4
    }
  },
  "distributed_runtime": {
    "enabled": true,
    "launcher": "mpirun",
    "world_size": 4,
    "capture_gpu_memory": true,
    "gpu_memory_sample_interval_ms": 200,
    "export_env": [
      "LD_LIBRARY_PATH",
      "CUDA_VISIBLE_DEVICES",
      "TRTMC_NCCL_RENDEZVOUS"
    ]
  },
  "testcases": [
    {
      "name": "t5-small-tp4",
      "reference_family": "seq2seq_text2text",
      "user_contract": "seq2seq_output",
      "prompt": "translate English to German: The house is wonderful.",
      "max_new_tokens": 20,
      "ci_tier": "multi_device",
      "preflight_requirements": [
        {
          "kind": "binary_exists",
          "args": {},
          "gating": true
        },
        {
          "kind": "command_available",
          "args": {
            "command": "mpirun"
          },
          "gating": true
        },
        {
          "kind": "gpu_count_min",
          "args": {
            "count": 4
          },
          "gating": true
        }
      ],
      "notes": "T5-small TP4 repro using the same checkpoint, prompt, and generation length as t5-small.",
      "metadata": {
        "contract_config": {
          "auto_class": "AutoModelForSeq2SeqLM"
        }
      }
    }
  ]
}
